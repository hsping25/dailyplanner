# 이 파일을 .env로 복사하고 값을 채우세요. (.env는 git에 올라가지 않음)
# 문장 파싱은 정규식 전용이라 API 키가 필요 없습니다. 아래는 아침 브리핑/알림용 텔레그램 봇 설정뿐.

# 아침 브리핑/알림용 텔레그램 봇 (5단계)
# 1) 텔레그램에서 @BotFather에게 /newbot → 토큰 받기
# 2) 만든 봇에게 아무 메시지나 보낸 뒤 npm run brief 실행하면 chat id 안내가 뜸
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 알림(브리핑/할일/10분전)을 어느 아이디의 일정으로 보낼지. 비우면 '기본'.
NOTIFY_USER=기본
