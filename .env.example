# 이 파일을 .env로 복사하고 값을 채우세요. (.env는 git에 올라가지 않음)

# 저장소: 넣으면 Postgres(Neon 등), 비우면 로컬 SQLite 파일. 로컬 개발은 비워두면 됩니다.
DATABASE_URL=
# (SQLite일 때) DB 파일 경로. 비우면 프로젝트폴더/planner.db
DB_PATH=

# 문장 파싱은 정규식 전용이라 API 키가 필요 없습니다. 아래는 아침 브리핑/알림용 텔레그램 봇 설정뿐.

# 아침 브리핑/할일/10분전 알림용 텔레그램 봇
# @BotFather에게 /newbot → 토큰 받아 아래에 넣기. 토큰 하나로 여러 사람에게 각각 전송 가능.
TELEGRAM_BOT_TOKEN=

# ↓ 아래 둘은 "레거시(단일 사용자)"용 — 이제는 앱에서 🔔(알림 연결)로 아이디별로 연결하는 게 기본.
# TELEGRAM_CHAT_ID를 넣어두면 그 chat이 NOTIFY_USER 아이디에 자동 연결됨(기존 설정 유지용).
TELEGRAM_CHAT_ID=
NOTIFY_USER=기본
